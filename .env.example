# PostgreSQL connection (set by docker-compose from DB_PASSWORD)
DATABASE_URL=postgresql://dictator:${DB_PASSWORD}@localhost:5432/dictator

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional)
OPENAI_API_KEY=sk-...

# Initial admin user (used by npm run db:seed only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Docker Compose DB password
DB_PASSWORD=changeme

# Instance-level trigger defaults (optional — fall back to "Computer" / "Assistant")
COMMAND_TRIGGER_DEFAULT=Computer
AI_TRIGGER_DEFAULT=Assistant

# SMTP for share invite emails (all optional — sharing still works without email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=smtp-password

# ============================================================================
# Privacy & Data Protection Configuration
# ============================================================================

# Telemetry - HMAC secret for pseudonymous user ID generation
# Generate with: openssl rand -base64 32
TELEMETRY_SERVER_SECRET=generate-with-openssl-rand

# Enable/disable telemetry collection by default (privacy-first: false by default)
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# Scheduled jobs & cleanup
# Secret for authenticating cleanup jobs (generate with: openssl rand -base64 32)
CRON_SECRET=generate-with-openssl-rand

# Enable automatic cleanup of ephemeral AI requests
ENABLE_EPHEMERAL_CLEANUP=true

# How often to run cleanup job (in minutes)
CLEANUP_INTERVAL_MINUTES=60

# Privacy-first mode (requires explicit consent before any data processing)
STRICT_GDPR_MODE=false

# Enable sensitive data detection before AI requests
FEATURE_SENSITIVE_DATA_DETECTION=true

# Enable document export with provenance metadata
FEATURE_EXPORT_WITH_PROVENANCE=true

# Enable account deletion UI
FEATURE_ACCOUNT_DELETION=true

# Enable privacy audit logging
ENABLE_AUDIT_LOGGING=true

# Privacy policy URLs (shown to users)
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://dictator.app/privacy
NEXT_PUBLIC_TERMS_OF_SERVICE_URL=https://dictator.app/terms

# Data Protection Officer email
DATA_PROTECTION_OFFICER_EMAIL=dpo@example.com

# Default data retention period (days)
DEFAULT_DATA_RETENTION_DAYS=30

# Encryption configuration
ENCRYPT_LOCAL_STORAGE=true
ENCRYPTION_ALGORITHM=aes-256-gcm
# Generate master key with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=generate-with-openssl-rand

# Logging
LOG_LEVEL=info
SANITIZE_LOGS=true

# Development only
DEV_SKIP_AUTH=false
DEBUG_PRIVACY=false

