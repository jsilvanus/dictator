<?xml version="1.0" encoding="utf-8"?>
<!-- Aidos Engine is reached over plain HTTP on the loopback interface (sdk/CONTRACT.md, "Transport"),
     which Android blocks by default for apps targeting API 28+. Only loopback is exempted; every
     other host must use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
